#!/bin/sh
# Release-contained launcher for one hash-bound, externally managed Python runtime.

set -eu

launcher_dir="$(CDPATH= cd "$(dirname "$0")" && pwd -P)"
release_root="$(dirname "$launcher_dir")"
runtime="${MAGI_V3_PYTHON_RUNTIME:-}"
runtime_realpath="${MAGI_V3_PYTHON_RUNTIME_REALPATH:-}"
expected="${MAGI_V3_PYTHON_RUNTIME_SHA256:-}"
runtime_manifest="${MAGI_V3_PYTHON_RUNTIME_MANIFEST:-}"
runtime_manifest_expected="${MAGI_V3_PYTHON_RUNTIME_MANIFEST_SHA256:-}"
runtime_tree_expected="${MAGI_V3_PYTHON_RUNTIME_TREE_SHA256:-}"
cron_jobs="${MAGI_CRON_JOBS_FILE:-}"
cron_expected="${MAGI_CRON_JOBS_SHA256:-}"
cron_source_expected="${MAGI_CRON_JOBS_SOURCE_SHA256:-}"
release_manifest="${MAGI_V3_RELEASE_MANIFEST:-}"
release_manifest_expected="${MAGI_V3_RELEASE_MANIFEST_SHA256:-}"
release_id="${MAGI_V3_RELEASE_ID:-}"

trusted_verifier=/usr/bin/python3
if [ ! -x "$trusted_verifier" ] || [ -L "$trusted_verifier" ]; then
  echo "MAGI V3 launcher: trusted system verifier is unavailable" >&2
  exit 126
fi
if ! "$trusted_verifier" -I -S - \
  "$release_root" "$release_manifest" "$release_manifest_expected" "$release_id" <<'PY'
import hashlib
import json
import os
import posixpath
import re
import stat
import sys

SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
COMMIT_RE = re.compile(r"^[0-9a-f]{40}(?:[0-9a-f]{24})?$")


def blocked(message):
    raise ValueError(message)


def signature(metadata):
    return (
        metadata.st_dev,
        metadata.st_ino,
        metadata.st_size,
        metadata.st_mtime_ns,
        stat.S_IMODE(metadata.st_mode),
        metadata.st_nlink,
    )


def stable_read(path, expected_mode, maximum):
    try:
        descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError as exc:
        blocked("unavailable release file: %s: %s" % (path, exc))
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or stat.S_IMODE(before.st_mode) != expected_mode:
            blocked("unsafe release file type or mode: %s" % path)
        if before.st_size > maximum:
            blocked("release metadata file is too large: %s" % path)
        chunks = []
        while True:
            chunk = os.read(descriptor, min(1024 * 1024, maximum + 1))
            if not chunk:
                break
            chunks.append(chunk)
            if sum(map(len, chunks)) > maximum:
                blocked("release metadata file is too large: %s" % path)
        after = os.fstat(descriptor)
        current = os.lstat(path)
        if (
            signature(before) != signature(after)
            or (after.st_dev, after.st_ino) != (current.st_dev, current.st_ino)
            or stat.S_ISLNK(current.st_mode)
        ):
            blocked("release file changed while being verified: %s" % path)
        return b"".join(chunks)
    finally:
        os.close(descriptor)


def stable_hash(path, expected_size, expected_mode):
    try:
        descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError as exc:
        blocked("unavailable release member: %s: %s" % (path, exc))
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_size != expected_size
            or stat.S_IMODE(before.st_mode) != expected_mode
        ):
            blocked("release member size or mode drift: %s" % path)
        digest = hashlib.sha256()
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
        after = os.fstat(descriptor)
        current = os.lstat(path)
        if (
            signature(before) != signature(after)
            or (after.st_dev, after.st_ino) != (current.st_dev, current.st_ino)
            or stat.S_ISLNK(current.st_mode)
        ):
            blocked("release member changed while being verified: %s" % path)
        return digest.hexdigest()
    finally:
        os.close(descriptor)


try:
    root, declared_manifest, expected_manifest_sha, release_id = sys.argv[1:]
    if (
        not root.startswith("/")
        or os.path.realpath(root) != root
        or stat.S_IMODE(os.lstat(root).st_mode) != 0o555
        or not stat.S_ISDIR(os.lstat(root).st_mode)
    ):
        blocked("release root is non-canonical, symlinked, or writable")
    manifest_path = os.path.join(root, "release-manifest.json")
    marker_path = os.path.join(root, "RELEASE_COMPLETE.json")
    if declared_manifest != manifest_path or not SHA256_RE.fullmatch(expected_manifest_sha):
        blocked("release manifest environment binding is invalid")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", release_id):
        blocked("release ID environment binding is invalid")

    manifest_bytes = stable_read(manifest_path, 0o444, 64 * 1024 * 1024)
    if hashlib.sha256(manifest_bytes).hexdigest() != expected_manifest_sha:
        blocked("release manifest SHA-256 mismatch")
    marker_bytes = stable_read(marker_path, 0o444, 1024 * 1024)
    try:
        manifest = json.loads(manifest_bytes.decode("utf-8"))
        marker = json.loads(marker_bytes.decode("utf-8"))
    except (UnicodeError, ValueError) as exc:
        blocked("release manifest or marker is invalid JSON: %s" % exc)
    if not isinstance(manifest, dict) or not isinstance(marker, dict):
        blocked("release manifest and marker must be JSON objects")
    commit = manifest.get("commit")
    if (
        manifest.get("schema_version") != 1
        or manifest.get("immutable") is not True
        or manifest.get("release_id") != release_id
        or not isinstance(commit, str)
        or not COMMIT_RE.fullmatch(commit)
    ):
        blocked("release manifest identity is invalid")
    if (
        marker.get("schema_version") != 1
        or marker.get("release_id") != release_id
        or marker.get("commit") != commit
        or marker.get("manifest") != "release-manifest.json"
        or marker.get("manifest_sha256") != expected_manifest_sha
    ):
        blocked("release completion marker binding is invalid")

    rows = manifest.get("files")
    if not isinstance(rows, list) or not rows:
        blocked("release inventory is missing")
    normalized = []
    inventory = {}
    expected_directories = {""}
    for row in rows:
        if not isinstance(row, dict) or set(row) != {"path", "sha256", "size", "mode"}:
            blocked("release inventory row is invalid")
        relative = row.get("path")
        digest = row.get("sha256")
        size = row.get("size")
        mode_text = row.get("mode")
        if (
            not isinstance(relative, str)
            or not relative
            or relative.startswith("/")
            or posixpath.normpath(relative) != relative
            or relative in {"release-manifest.json", "RELEASE_COMPLETE.json"}
            or relative in inventory
            or not isinstance(digest, str)
            or not SHA256_RE.fullmatch(digest)
            or type(size) is not int
            or size < 0
            or mode_text not in {"0444", "0555"}
        ):
            blocked("release inventory row is unsafe")
        inventory[relative] = row
        normalized.append({"path": relative, "sha256": digest, "size": size, "mode": mode_text})
        parent = posixpath.dirname(relative)
        while parent:
            expected_directories.add(parent)
            parent = posixpath.dirname(parent)
    normalized.sort(key=lambda item: item["path"])
    inventory_sha = hashlib.sha256(
        json.dumps(normalized, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    if not (
        manifest.get("source_file_count") == len(rows)
        and manifest.get("source_snapshot_sha256") == inventory_sha
        and manifest.get("release_sha256") == inventory_sha
        and marker.get("source_file_count") == len(rows)
        and marker.get("source_snapshot_sha256") == inventory_sha
        and marker.get("release_sha256") == inventory_sha
    ):
        blocked("release inventory identity is invalid")

    for relative, row in inventory.items():
        path = os.path.join(root, *relative.split("/"))
        if stable_hash(path, row["size"], int(row["mode"], 8)) != row["sha256"]:
            blocked("release member SHA-256 mismatch: %s" % relative)

    actual_files = set()
    actual_directories = set()
    for directory, directory_names, file_names in os.walk(root, followlinks=False):
        relative_directory = os.path.relpath(directory, root)
        relative_directory = "" if relative_directory == "." else relative_directory
        actual_directories.add(relative_directory)
        metadata = os.lstat(directory)
        if (
            stat.S_ISLNK(metadata.st_mode)
            or not stat.S_ISDIR(metadata.st_mode)
            or stat.S_IMODE(metadata.st_mode) != 0o555
        ):
            blocked("release directory is unsafe or writable: %s" % relative_directory)
        for name in directory_names:
            child = os.path.join(directory, name)
            if stat.S_ISLNK(os.lstat(child).st_mode):
                blocked("release contains symlinked directory: %s" % child)
        for name in file_names:
            child = os.path.join(directory, name)
            child_metadata = os.lstat(child)
            if stat.S_ISLNK(child_metadata.st_mode) or not stat.S_ISREG(child_metadata.st_mode):
                blocked("release contains unsafe file: %s" % child)
            actual_files.add(os.path.relpath(child, root).replace(os.sep, "/"))
    expected_files = set(inventory) | {"release-manifest.json", "RELEASE_COMPLETE.json"}
    if actual_files != expected_files or actual_directories != expected_directories:
        blocked("release contains missing or extra files/directories")
    if stable_read(manifest_path, 0o444, 64 * 1024 * 1024) != manifest_bytes:
        blocked("release manifest changed after inventory verification")
    if stable_read(marker_path, 0o444, 1024 * 1024) != marker_bytes:
        blocked("release completion marker changed after inventory verification")
except Exception as exc:
    sys.stderr.write("MAGI V3 trusted release verifier: %s\n" % exc)
    raise SystemExit(1)
PY
then
  echo "MAGI V3 launcher: release verification failed" >&2
  exit 126
fi

case "$runtime" in
  /*) ;;
  *) echo "MAGI V3 launcher: MAGI_V3_PYTHON_RUNTIME must be absolute" >&2; exit 126 ;;
esac

case "$expected" in
  ""|*[!0-9a-f]*)
    echo "MAGI V3 launcher: MAGI_V3_PYTHON_RUNTIME_SHA256 must be lowercase SHA-256" >&2
    exit 126
    ;;
esac
if [ "${#expected}" -ne 64 ]; then
  echo "MAGI V3 launcher: MAGI_V3_PYTHON_RUNTIME_SHA256 must be lowercase SHA-256" >&2
  exit 126
fi

case "$runtime_realpath" in
  /*) ;;
  *) echo "MAGI V3 launcher: MAGI_V3_PYTHON_RUNTIME_REALPATH must be absolute" >&2; exit 126 ;;
esac

if [ ! -e "$runtime" ] || [ ! -x "$runtime" ]; then
  echo "MAGI V3 launcher: Python runtime is missing or not executable" >&2
  exit 126
fi
observed_realpath="$(/bin/realpath "$runtime")"
if [ "$observed_realpath" != "$runtime_realpath" ] || [ -L "$runtime_realpath" ] || [ ! -f "$runtime_realpath" ]; then
  echo "MAGI V3 launcher: Python runtime symlink target mismatch" >&2
  exit 126
fi

actual="$(/usr/bin/shasum -a 256 "$runtime_realpath")"
actual="${actual%% *}"
if [ "$actual" != "$expected" ]; then
  echo "MAGI V3 launcher: Python runtime hash mismatch" >&2
  exit 126
fi

case "$runtime_manifest" in
  /*) ;;
  *) echo "MAGI V3 launcher: Python runtime manifest must be absolute" >&2; exit 126 ;;
esac
case "$runtime_manifest_expected:$runtime_tree_expected" in
  *[!0-9a-f:]*|:*|*:)
    echo "MAGI V3 launcher: Python runtime manifest/tree SHA-256 is invalid" >&2
    exit 126
    ;;
esac
if [ "${#runtime_manifest_expected}" -ne 64 ] || [ "${#runtime_tree_expected}" -ne 64 ] \
  || [ -L "$runtime_manifest" ] || [ ! -f "$runtime_manifest" ]; then
  echo "MAGI V3 launcher: Python runtime manifest binding is unsafe" >&2
  exit 126
fi
runtime_manifest_actual="$(/usr/bin/shasum -a 256 "$runtime_manifest")"
runtime_manifest_actual="${runtime_manifest_actual%% *}"
if [ "$runtime_manifest_actual" != "$runtime_manifest_expected" ]; then
  echo "MAGI V3 launcher: Python runtime manifest hash mismatch" >&2
  exit 126
fi

case "$cron_jobs" in
  /*) ;;
  *) echo "MAGI V3 launcher: MAGI_CRON_JOBS_FILE must be absolute" >&2; exit 126 ;;
esac
case "$cron_expected" in
  ""|*[!0-9a-f]*)
    echo "MAGI V3 launcher: MAGI_CRON_JOBS_SHA256 must be lowercase SHA-256" >&2
    exit 126
    ;;
esac
case "$cron_source_expected" in
  ""|*[!0-9a-f]*)
    echo "MAGI V3 launcher: MAGI_CRON_JOBS_SOURCE_SHA256 must be lowercase SHA-256" >&2
    exit 126
    ;;
esac
if [ "${#cron_expected}" -ne 64 ] || [ "${#cron_source_expected}" -ne 64 ] \
  || [ -L "$cron_jobs" ] || [ ! -f "$cron_jobs" ]; then
  echo "MAGI V3 launcher: cron jobs file or SHA-256 is unsafe" >&2
  exit 126
fi
cron_actual="$(/usr/bin/shasum -a 256 "$cron_jobs")"
cron_actual="${cron_actual%% *}"
if [ "$cron_actual" != "$cron_expected" ]; then
  echo "MAGI V3 launcher: cron jobs file hash mismatch" >&2
  exit 126
fi

: "${MAGI_V3_STATE_DIR:?MAGI V3 launcher: MAGI_V3_STATE_DIR is required}"
: "${MAGI_V3_RELEASE_ID:?MAGI V3 launcher: MAGI_V3_RELEASE_ID is required}"
canonical_runtime="${HOME}/Library/Application Support/MAGI/runtime/MAGI_v3"
shared_state="${MAGI_V3_SHARED_STATE_DIR:-$canonical_runtime/shared}"
if [ ! -d "$canonical_runtime" ] || [ -L "$canonical_runtime" ] \
  || [ "$(/bin/realpath "$canonical_runtime")" != "$canonical_runtime" ]; then
  echo "MAGI V3 launcher: canonical runtime root is missing or unsafe" >&2
  exit 126
fi
case "$MAGI_V3_STATE_DIR/" in
  "$canonical_runtime/state/"*) ;;
  *) echo "MAGI V3 launcher: role state directory is outside canonical runtime" >&2; exit 126 ;;
esac
if [ ! -d "$MAGI_V3_STATE_DIR" ] || [ -L "$MAGI_V3_STATE_DIR" ] \
  || [ "$(/bin/realpath "$MAGI_V3_STATE_DIR")" != "$MAGI_V3_STATE_DIR" ]; then
  echo "MAGI V3 launcher: role state directory is missing or unsafe" >&2
  exit 126
fi
if [ "$shared_state" != "$canonical_runtime/shared" ]; then
  echo "MAGI V3 launcher: shared state directory is outside canonical runtime" >&2
  exit 126
fi
if [ -L "$shared_state" ]; then
  echo "MAGI V3 launcher: shared state directory is symlinked" >&2
  exit 126
fi
/bin/mkdir -p "$shared_state"
if [ "$(/bin/realpath "$shared_state")" != "$shared_state" ]; then
  echo "MAGI V3 launcher: shared state directory is unsafe" >&2
  exit 126
fi
for relative in \
  runtime agent exports metrics autopilot-runs static pdf-namer skill-overlays \
  autoresearch-runs memory file-review \
  runtime/locks runtime/cache runtime/pending-config runtime/taiwan_legal_mcp \
  runtime/cache/paperclip-preview runtime/cache/paperclip-uploads runtime/cache/judicial_web_search runtime/cache/laws \
  skill-overlays/.runtime-site-packages skill-overlays/.logs skill-overlays/.iron-dome \
  memory/index_cache file-review/bg-jobs file-review/downloads
do
  child="$shared_state/$relative"
  if [ -L "$child" ]; then
    echo "MAGI V3 launcher: shared state child is symlinked: $relative" >&2
    exit 126
  fi
  /bin/mkdir -p "$child"
  if [ ! -d "$child" ] || [ -L "$child" ]; then
    echo "MAGI V3 launcher: shared state child is missing or unsafe: $relative" >&2
    exit 126
  fi
  child_real="$(/bin/realpath "$child")"
  if [ "$child_real" != "$child" ]; then
    echo "MAGI V3 launcher: shared state child escapes canonical path: $relative" >&2
    exit 126
  fi
  case "$child_real/" in
    "$shared_state/"*) ;;
    *) echo "MAGI V3 launcher: shared state child escapes shared root: $relative" >&2; exit 126 ;;
  esac
done
case "$release_root/" in
  "$canonical_runtime/"*) echo "MAGI V3 launcher: release overlaps canonical runtime" >&2; exit 126 ;;
esac

unset PYTHONHOME PYTHONPLATLIBDIR PYTHONUSERBASE PYTHONSTARTUP PYTHONINSPECT \
  PYTHONEXECUTABLE __PYVENV_LAUNCHER__
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPYCACHEPREFIX=/dev/null
export MAGI_V3_SHARED_STATE_DIR="$shared_state"
export MAGI_SHARED_STATE_DIR="$shared_state"
export MAGI_ROOT="$release_root"
export MAGI_ROOT_DIR="$release_root"
export MAGI_CODE_DIR="$release_root/casper_ecosystem/law_firm_orchestrators"
export MAGI_ORCH_DIR="$release_root/casper_ecosystem/law_firm_orchestrators"
: "${MAGI_JSON_DIR:?MAGI V3 launcher: MAGI_JSON_DIR is required}"
case "$MAGI_JSON_DIR" in
  /*) ;;
  *) echo "MAGI V3 launcher: MAGI_JSON_DIR must be absolute" >&2; exit 126 ;;
esac
if [ ! -d "$MAGI_JSON_DIR" ] || [ -L "$MAGI_JSON_DIR" ] \
  || [ "$(/bin/realpath "$MAGI_JSON_DIR")" != "$MAGI_JSON_DIR" ]; then
  echo "MAGI V3 launcher: MAGI_JSON_DIR is missing or unsafe" >&2
  exit 126
fi
case "$MAGI_JSON_DIR/" in
  "$release_root/"*) echo "MAGI V3 launcher: MAGI_JSON_DIR overlaps immutable release" >&2; exit 126 ;;
esac
export MAGI_JSON_DIR
export MAGI_SKILL_PYTHON="$runtime"
export MAGI_RUNTIME_DIR="$shared_state/runtime"
export MAGI_AGENT_DIR="$shared_state/agent"
export MAGI_DATA_DIR="$shared_state/agent"
export MAGI_EXPORTS_DIR="$shared_state/exports"
export MAGI_GCAL_DUP_AUDIT_OUTPUT_DIR="$shared_state/exports/gcal_dedup"
export MAGI_METRICS_DIR="$shared_state/metrics"
export MAGI_AUTOPILOT_RUNS_DIR="$shared_state/autopilot-runs"
export MAGI_MUTABLE_STATIC_DIR="$shared_state/static"
export MAGI_LOG_DIR="${MAGI_V3_LOG_DIR:-$shared_state/runtime/logs}"
export MAGI_BACKGROUND_LOCK_DIR="$shared_state/runtime/locks"
export MAGI_FILE_REVIEW_STATE_DIR="$shared_state/file-review"
export MAGI_FILE_REVIEW_BG_JOB_DIR="$shared_state/file-review/bg-jobs"
export MAGI_EEFILE_DOWNLOAD_FOLDER="$shared_state/file-review/downloads"
export MAGI_FILE_REVIEW_EMAIL_MONITOR_STATE="$shared_state/static/file_review_email_monitor_state.json"
export MAGI_FILE_REVIEW_PENDING_PATH="$shared_state/agent/file-review/review_submit_pending.json"
export MAGI_LAF_GMAIL_STATE_PATH="$shared_state/static/laf_gmail_monitor_state.json"
export MAGI_LAF_GMAIL_MONITOR_STATE="$shared_state/static/laf_gmail_monitor_state.json"
export MAGI_LAF_GMAIL_PENDING_PATH="$shared_state/runtime/laf_gmail_dispatch_pending.json"
export MAGI_BRAIN_SQLITE_PATH="$shared_state/agent/magi_brain.db"
export MAGI_CLOUDFLARED_LOG_PATH="$MAGI_LOG_DIR/cloudflared.log"
export MAGI_DAEMON_LOG_PATH="$shared_state/agent/daemon.log"
export MAGI_PENDING_ENV_UPDATE_FILE="$shared_state/runtime/pending-config/env_updates.json"
export MAGI_OSC_FILE_SHARE_STORE="$shared_state/runtime/osc_file_shares.json"
export MAGI_OSC_FILE_SHARE_PUBLIC_BASE_FILE="$shared_state/runtime/osc_share_public_base_url.txt"
export MAGI_OSC_PREVIEW_CACHE_DIR="$shared_state/runtime/cache/paperclip-preview"
export MAGI_OSC_PREVIEW_CACHE_MAX_BYTES="1073741824"
export MAGI_OSC_UPLOAD_CACHE_DIR="$shared_state/runtime/cache/paperclip-uploads"
export MAGI_WORLDMONITOR_REPORT_DIR="$shared_state/static/worldmonitor_reports"
export MAGI_AGENT_STATUS_PUBLIC_PATH="$shared_state/static/agent_status_public_latest.json"
export MAGI_SAAS_AUDIT_PATH="$shared_state/runtime/saas_audit_events.jsonl"
export MAGI_RATE_LIMIT_DB_PATH="$shared_state/runtime/rate_limit.sqlite3"
export MAGI_GIBBERISH_LOG="$shared_state/static/gibberish_samples.jsonl"
export MAGI_TAIWAN_LEGAL_MCP_ROOT="$shared_state/runtime/mcp-taiwan-legal-db"
export MAGI_TAIWAN_LEGAL_MCP_CACHE="$shared_state/runtime/taiwan_legal_mcp/cache.sqlite3"
export MAGI_PDF_NAMER_STATE_DIR="$shared_state/pdf-namer"
export MAGI_SKILL_OVERLAY_DIR="$shared_state/skill-overlays"
export MAGI_SKILL_RUNTIME_SITE_PACKAGES="$shared_state/skill-overlays/.runtime-site-packages"
export MAGI_SKILL_EVENTS_FILE="$shared_state/skill-overlays/.logs/skill_runtime_events.jsonl"
export MAGI_SKILL_USAGE_TRACKER_FILE="$shared_state/skill-overlays/.logs/skill_usage_events.jsonl"
export MAGI_SKILL_INTERVIEW_HISTORY_FILE="$shared_state/skill-overlays/.logs/skill_interview_history.jsonl"
export MAGI_IRON_DOME_STATE_DIR="$shared_state/skill-overlays/.iron-dome"
export MAGI_IRON_DOME_DYNAMIC_RULES_PATH="$shared_state/skill-overlays/.iron-dome/dynamic_rules.json"
export MAGI_IRON_DOME_PATTERNS_CACHE_FILE="$shared_state/skill-overlays/.iron-dome/patterns_cache.json"
export MAGI_IRON_DOME_UPSTREAM_STATE_FILE="$shared_state/skill-overlays/.iron-dome/upstream_last.json"
export MAGI_AUTORESEARCH_RUNS_DIR="$shared_state/autoresearch-runs"
export JUDICIAL_CACHE_DIR="$shared_state/runtime/cache/judicial_web_search"
export MAGI_LAW_CACHE_DIR="$shared_state/runtime/cache/laws"
export MAGI_LAW_VDB_STATE_PATH="$shared_state/agent/_statutes_vdb_state.json"
export FAISS_INDEX_DIR="$shared_state/memory/index_cache"
export MAGI_TRAINING_LOCK_PATH="${HOME}/Library/Application Support/MAGI/training.lock"
export MAGI_USE_RUNTIME_DIR=1
export MAGI_CRON_DEFINITIONS_IMMUTABLE=1
export PYTHONPATH="$release_root"
export PYTHONNOUSERSITE=1
export PYTHONSAFEPATH=1
export PYTEST_ADDOPTS="${PYTEST_ADDOPTS:+$PYTEST_ADDOPTS }-p no:cacheprovider"

if ! "$trusted_verifier" -I -S "$release_root/scripts/v3_python_runtime_snapshot.py" verify \
  --manifest "$runtime_manifest" \
  --expected-tree-sha256 "$runtime_tree_expected" \
  --expected-python-runtime "$runtime" \
  --expected-python-realpath "$runtime_realpath" \
  --singleflight-cache "$shared_state/runtime/python-runtime-verification.json" \
  --singleflight-max-age-seconds 3 >/dev/null; then
  echo "MAGI V3 launcher: Python runtime tree verification failed" >&2
  exit 126
fi

# A caller may add ordinary interpreter flags, but must not replace the
# release-bound cache policy.  Command-line -B/-X remain effective even when
# a caller legitimately uses -I or -E and Python ignores PYTHON* variables.
expect_x_value=0
for argument in "$@"; do
  if [ "$expect_x_value" -eq 1 ]; then
    case "$argument" in
      pycache_prefix|pycache_prefix=*)
        echo "MAGI V3 launcher: Python bytecode cache policy override is forbidden" >&2
        exit 126
        ;;
    esac
    expect_x_value=0
    continue
  fi
  case "$argument" in
    --|-c|-m) break ;;
    -X) expect_x_value=1 ;;
    -Xpycache_prefix|-Xpycache_prefix=*)
      echo "MAGI V3 launcher: Python bytecode cache policy override is forbidden" >&2
      exit 126
      ;;
    -*) ;;
    *) break ;;
  esac
done

exec "$runtime" -B -X pycache_prefix=/dev/null "$@"
