      "Do not route to China-origin or China-hosted model families.",
      "Dense 31B local models are experimental only on this 24GB unified-memory host.",
      "26B-A4B may be used only when it is already live and resource gates are safe."
    ],
    "disallowed_markers": [
      "qwen",
      "deepseek",
      "kimi",
      "minimax",
      "baichuan",
      "moonshot",
      "internlm",
      "chatglm",
      "glm",
      "yi"
    ]
  },
