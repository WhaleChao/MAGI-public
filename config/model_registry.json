      "active_parameters_b": 4,
      "quantization": "4bit",
      "local_dir": "~/.omlx/models/gemma-4-e4b-it-4bit",
      "safe_context_tokens": 8192,
      "max_concurrency": 1,
      "public_allowed": true,
      "private_allowed": true,
