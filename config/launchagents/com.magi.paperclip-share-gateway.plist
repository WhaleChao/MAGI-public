<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.magi.paperclip-share-gateway</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>app="${MAGI_APP_ROOT:-$HOME/Library/Application Support/MAGI}"; launcher="${MAGI_ACTIVE_SERVICE_LAUNCHER:-$app/bin/magi-active-release-service.py}"; python="${MAGI_ACTIVE_SERVICE_PYTHON:-/usr/bin/python3}"; test -f "$launcher" &amp;&amp; test -x "$python" || exit 78; exec "$python" "$launcher" paperclip-share-gateway</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PAPERCLIP_SHARE_GATEWAY_TARGET</key>
        <string>http://127.0.0.1:5002</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/magi-paperclip-share-gateway.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/magi-paperclip-share-gateway.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
