{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magi.local/schemas/v3/workflow-plan.schema.json",
  "title": "MAGI V3 Immutable Workflow Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "revision", "session_id", "context_snapshot_id", "intent", "risk", "status", "created_at", "steps"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "session_id": {"type": "string", "minLength": 1},
    "context_snapshot_id": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "status": {"enum": ["draft", "awaiting_input", "awaiting_confirmation", "ready", "running", "succeeded", "failed", "blocked", "cancelled"]},
    "created_at": {"type": "string", "format": "date-time"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "capability", "operation", "depends_on", "side_effect_class", "status", "input_refs", "output_refs"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "side_effect_class": {"enum": ["none", "read_only", "local_draft", "reversible_write", "external_commit", "destructive"]},
          "status": {"enum": ["pending", "ready", "running", "awaiting_input", "awaiting_confirmation", "succeeded", "failed", "skipped", "cancelled"]},
          "input_refs": {"type": "array", "items": {"type": "string"}},
          "output_refs": {"type": "array", "items": {"type": "string"}},
          "confirmation": {"type": ["object", "null"]},
          "timeout_sec": {"type": ["integer", "null"], "minimum": 1},
          "retry_policy": {"type": ["object", "null"]}
        }
      }
    }
  },
  "$comment": "The runtime validator must additionally reject duplicate step_id values, cycles, missing dependencies and illegal status transitions."
}
