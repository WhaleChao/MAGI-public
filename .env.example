# MAGI legacy/source-development environment example.
# New self-host installations should use scripts/magi_selfhost.py; it stores
# secrets outside the source tree in an OS-native per-user directory.
FLASK_SECRET_KEY=<random-hex-string>
MAGI_API_KEY=<random-hex-string>
MAGI_ROOT_DIR=/path/to/MAGI
MAGI_SKILL_PYTHON=/path/to/MAGI/.venv/bin/python

# Required MySQL/MariaDB connection for the full OSC and business modules.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=magi
MAGI_BRAIN_DB_NAME=magi_brain

# Optional model and messaging providers.
NVIDIA_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
MAGI_LAF_USERNAME=
MAGI_LAF_PASSWORD=
MAGI_JUDICIAL_EEFILE_USERNAME=
MAGI_JUDICIAL_EEFILE_PASSWORD=
DISCORD_BOT_TOKEN=
OPENCLAW_TELEGRAM_BOT_TOKEN=
MAGI_LINE_CHANNEL_ACCESS_TOKEN=
